<UserControl x:Class="ZwcadBatchPlot.AboutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" FontSize="11">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16,12,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题：字号与主打印页一致，仅加粗区分产品名 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="LA 批量打印" FontWeight="Bold"
                       Foreground="#FF1A73E8" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding VersionText}"
                       Foreground="DimGray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="#FFE0E0E0" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Margin="8,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="设计：" Foreground="DimGray" Width="48"/>
                <TextBlock Text="爱德华hehe"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="邮箱：" Foreground="DimGray" Width="48"/>
                <TextBlock Text="527152927@qq.com"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="QQ群：" Foreground="DimGray" Width="48"/>
                <TextBlock Text="829218271"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="3" Height="1" Background="#FFE0E0E0" Margin="0,8,0,10"/>

        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="QQ 群" MinWidth="76"
                    Style="{StaticResource PluginButtonStyle}"
                    Click="OnQqGroupClick" Margin="0,0,4,0"/>
            <Button Content="确定" MinWidth="76"
                    Style="{StaticResource PluginButtonStyle}"
                    Click="OnOkClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</UserControl>
